{
  "manifest_version": 3,
  "name": "Drop & View Render",
  "description": "Render Drop & View scenes with the native Blender/Cycles companion.",
  "version": "0.1.0",
  "permissions": ["nativeMessaging"],
  "background": { "scripts": ["background.js"], "type": "module", "persistent": false },
  "content_scripts": [{
    "matches": ["https://hildgyorgy.github.io/drop-3d-view/*", "http://localhost/*", "http://127.0.0.1/*"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": false
  }]
}
