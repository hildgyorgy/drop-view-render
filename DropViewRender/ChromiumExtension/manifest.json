{
  "manifest_version": 3,
  "name": "Drop & View Render",
  "version": "0.2.0",
  "description": "Send Drop & View scenes to the native Cycles renderer.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://hildgyorgy.github.io/drop-3d-view/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
